# ============================================================
# FunnelAI — Variáveis de Ambiente
# ============================================================
# ATENÇÃO: Copie este arquivo para .env e preencha os valores.
# As chaves de IA em produção são gerenciadas pelo SuperAdmin
# no painel /superadmin/config — não precisam ficar aqui.
# Este arquivo serve apenas como FALLBACK para dev local.
# ============================================================

# --- DATABASE ------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/funnelai"
DIRECT_URL="postgresql://postgres:password@localhost:5432/funnelai"

# --- REDIS ---------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- AUTH (Clerk) --------------------------------------------
# Crie em: https://clerk.com ? New Application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- SUPERADMIN ----------------------------------------------
# Seu Clerk User ID (veja em clerk.com no seu perfil)
# Execute em seguida: npx prisma studio ? SuperAdmin ? Insert Row
SUPERADMIN_CLERK_USER_ID=user_xxx

# --- SEGURANÇA INTERNA ---------------------------------------
# Token secreto para comunicação scanner ? web app (gere um aleatório)
INTERNAL_API_TOKEN=change-this-to-a-random-secret-string

# Chave de encriptação AES-256 para as configs no banco (exatamente 32 chars)
CONFIG_ENCRYPTION_KEY=change-this-to-exactly-32-chars!!

# --- AI PROVIDERS (FALLBACK LOCAL) ---------------------------
# ?? Em PRODUÇÃO, estas chaves são configuradas pelo SuperAdmin
# em /superadmin/config e ficam no banco de dados (encriptadas).
# Aqui são usadas APENAS em desenvolvimento local como fallback.
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=xxx
REPLICATE_API_KEY=r8_xxx

# --- SCREENSHOT-TO-CODE --------------------------------------
# URL do serviço self-hosted (interno, não exposto à internet)
SCREENSHOT_TO_CODE_URL=http://localhost:7001

# --- STORAGE (AWS S3) ----------------------------------------
# Em produção, configurado via /superadmin/config
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=us-east-1
S3_BUCKET_NAME=funnelai-assets
CDN_URL=https://cdn.funnelai.com

# --- PAYMENTS (Stripe) ---------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- EMAIL (Resend) ------------------------------------------
RESEND_API_KEY=re_xxx
EMAIL_FROM=FunnelAI <noreply@funnelai.com>

# --- PROXY (Scanner stealth) ---------------------------------
# Em produção, configurado via /superadmin/config
# Formato: http://user:pass@proxy.provider.com:8080
PROXY_URL=

# --- SCANNER SERVICE -----------------------------------------
SCANNER_SERVICE_URL=http://localhost:8001

# --- APP -----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
