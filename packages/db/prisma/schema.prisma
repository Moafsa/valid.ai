generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Workspace (multi-tenant) ────────────────────────────
model Workspace {
  id        String   @id @default(cuid())
  clerkOrgId String  @unique
  name      String
  slug      String   @unique
  /// legacy enum, kept in step with planKey for the four built-in plans (new code reads planKey)
  plan      Plan     @default(FREE)
  /// the plan this account is on: a plan_configs.key (BASIC, PRO, SCALE, UNLIMITED, FREE or any plan the administrator created)
  planKey   String   @default("FREE")
  /// none (no subscription) | active | past_due | canceled: a paid plan only counts while it is active (see lib/plans.ts)
  subscriptionStatus String @default("none")
  /// paid through this date (a few days of grace are given after it); null = no expiry (cortesia, unlimited plan)
  planUntil DateTime?
  aiCredits Int      @default(50)
  /// extra AI credits given by the administrator or bought: only spent once the month's plan allowance is used up (see lib/plans.ts)
  bonusCredits Int   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  members   WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  clerkUserId String
  role        MemberRole @default(MEMBER)
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, clerkUserId])
  @@map("workspace_members")
}

// ─── Project ─────────────────────────────────────────────
model Project {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  sourceUrl    String
  type         ProjectType   @default(LP)
  status       ProjectStatus @default(PENDING)
  thumbnail    String?
  scanJobId    String?       @unique
  // Public slug used at /f/[slug or id]/[pageSlug] instead of the raw
  // cuid. Optional: projects published before this existed keep resolving
  // by id.
  slug         String?       @unique
  // Custom domain associated with this project at publish time. Storage
  // only — actually routing a real domain here needs DNS + a TLS cert,
  // which nothing in this repo automates (see /domains, still a static
  // page with no backend).
  customDomain String?       @unique
  // {found, completed, failed: [{url, error}]} from the crawler's last
  // run — kept after the scan finishes so the dashboard can always show
  // "N páginas encontradas, M clonadas, K falharam" without needing the
  // live SSE stream.
  crawlStats   Json?
  // When the public version was last generated by "Publicar". The public
  // address serves only that snapshot (PublishedPage), never the pages being
  // edited: editing and publishing are separate steps.
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages       Page[]
  publishedPages PublishedPage[]
  /// analytics settings: {goals:[{id,name,type,value,conversion}], recording:{on,sample,maxPerDay}} (see lib/analytics/goals.ts)
  analyticsSettings Json?
  /// pixels & events of the public pages: {consent:{required,respectDnt,text}, events:[...], currency} (see lib/pixels.ts)
  pixelSettings Json?
  /// the size of everything stored for this project (images, fonts, videos), measured from the bucket; storageAt = when
  storageKb Int?
  storageAt DateTime?
  pixelEvents PixelEvent[]
  analyticsSessions AnalyticsSession[]
  experiments Experiment[]
  scanJob     ScanJob?  @relation(fields: [scanJobId], references: [id])
  trackings   ProjectTracking[]
  pageEvents  PageEvent[]

  @@map("projects")
}

// ─── Page Events (first-party analytics) ──────────────────
// "view" is recorded once per page load by the public clone viewer's own
// tracking beacon; "lead" is recorded whenever a visitor submits any form
// on that page (see api/track). Kept as one lean table — visitantes =
// count(type=view), conversões = count(type=lead) — rather than a
// separate aggregate table, since raw events are cheap at this volume and
// let the dashboard slice by day/page later without a schema change.
model PageEvent {
  id        String   @id @default(cuid())
  projectId String
  pageId    String?
  type      String
  path      String?
  referrer  String?
  /// extra detail for some event types (e.g. type "video": which video, how far, how long)
  data      Json?
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, type])
  @@map("page_events")
}

// ─── Page ────────────────────────────────────────────────
model Page {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  slug        String
  order       Int      @default(0)
  blocks      Json     @default("[]")
  customCss   String?
  // The wrapper chain around the page's blocks as the original had it:
  // {html, body, wrappers:[{tag,attrs}], viewport, title, fontLinks}.
  // Null on pages cloned before this existed (they keep rendering through
  // the legacy path); present means blocks are the real children of the
  // original content root and customCss is the original stylesheet.
  shell       Json?
  publishedUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@map("pages")
}

// ─── Behaviour analytics (first-party, Clarity-style) ────
// One row per visit. Everything the dashboard filters by lives here (where the visit came from, what device, where,
// what it did), so a filter is one WHERE clause and not a join over millions of events.
model AnalyticsSession {
  id             String   @id @default(cuid())
  projectId      String
  /// the id the page made up for this visit (kept per tab, renewed after 30 min idle)
  sid            String
  /// the id of the browser (kept for good): tells new visitors from returning ones
  visitorId      String
  startedAt      DateTime
  lastSeenAt     DateTime
  durationMs     Int      @default(0)
  activeMs       Int      @default(0)
  /// published = the public site, draft = the working copy opened by link
  mode           String   @default("published")
  host           String?
  landingSlug    String?
  landingPath    String?
  exitSlug       String?
  referrer       String?
  referrerDomain String?
  /// direct | organic | social | paid | email | referral | internal
  channel        String?
  /// the one name the dashboard groups by: utm_source when there is one, else the site the visit came from (facebook, google, instagram...), else "direct"
  source         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  /// fbclid / gclid / ttclid ... : proof the visit came from an ad
  clickId        String?
  clickIdType    String?
  device         String?
  /// Samsung, Apple, Xiaomi... and the model when the browser tells (iPhone: by the size of the screen)
  deviceBrand    String?
  deviceModel    String?
  /// the app the link was opened inside of (Instagram, Facebook, TikTok...): its own browser, not the phone's
  inApp          String?
  /// 4g / 3g / 2g / slow-2g as the browser reports it (not every browser does)
  connection     String?
  saveData       Boolean?
  dpr            Float?
  memoryGb       Float?
  cores          Int?
  /// how fast the page really was for this person (milliseconds; cls has no unit)
  lcpMs          Int?
  fcpMs          Int?
  ttfbMs         Int?
  loadMs         Int?
  cls            Float?
  /// how promising this lead looks, 0-100, from what they did (time, scroll, video, button, form, conversion)
  score          Int      @default(0)
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?
  screenW        Int?
  screenH        Int?
  viewportW      Int?
  viewportH      Int?
  language       String?
  timezone       String?
  country        String?
  region         String?
  city           String?
  isNew          Boolean  @default(true)
  isBot          Boolean  @default(false)
  pageCount      Int      @default(0)
  clickCount     Int      @default(0)
  rageCount      Int      @default(0)
  deadCount      Int      @default(0)
  maxScroll      Int      @default(0)
  videoPlays     Int      @default(0)
  /// how far (0-100) the furthest video of the visit was watched
  videoMaxPct    Int      @default(0)
  ctaClicks      Int      @default(0)
  formStarts     Int      @default(0)
  interacted     Boolean  @default(false)
  /// the page's own script reported at least once (false = only the server saw this visit: a tracker blocker, JavaScript off, or a very short stay)
  jsSeen         Boolean  @default(false)
  converted      Boolean  @default(false)
  convertedAt    DateTime?
  goal           String?
  leadId         String?
  expId          String?
  variant        String?

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageviews      AnalyticsPageview[]
  clicks         AnalyticsClick[]
  events         AnalyticsEvent[]
  videos         VideoView[]
  recording      Recording?

  @@unique([projectId, sid])
  @@index([projectId, startedAt])
  @@index([projectId, visitorId])
  @@index([projectId, utmCampaign])
  @@index([projectId, source])
  @@index([projectId, inApp])
  @@map("analytics_sessions")
}

model AnalyticsPageview {
  id         String   @id @default(cuid())
  projectId  String
  sessionId  String
  seq        Int      @default(0)
  slug       String?
  path       String?
  title      String?
  enteredAt  DateTime
  leftAt     DateTime?
  activeMs   Int      @default(0)
  maxScroll  Int      @default(0)
  clicks     Int      @default(0)
  /// navigate = went on to another page of the site, leave = closed/left the site, idle = stopped answering
  exitKind   String?
  /// seconds the visitor spent with each tenth of the page (10 numbers): where the attention was
  bands      Json?

  session    AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([projectId, enteredAt])
  @@index([projectId, slug])
  @@map("analytics_pageviews")
}

/// Every click, typed, so a heatmap is one aggregate query.
model AnalyticsClick {
  id        String   @id @default(cuid())
  projectId String
  sessionId String
  slug      String?
  ts        DateTime
  /// css path of the element that was pressed (stable across screen sizes)
  sel       String?
  tag       String?
  text      String?
  href      String?
  /// point on the page (px from the top-left of the document) and the size of the document / window then
  x         Int?
  y         Int?
  docW      Int?
  docH      Int?
  vw        Int?
  vh        Int?
  /// where inside the element (0-1000), so the same click can be drawn on any screen size
  ox        Int?
  oy        Int?
  device    String?
  isCta     Boolean  @default(false)
  dead      Boolean  @default(false)
  rage      Boolean  @default(false)
  video     Boolean  @default(false)

  session   AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId, slug, ts])
  @@index([sessionId])
  @@map("analytics_clicks")
}

/// Everything else a visit does, in order: scroll milestones, form fields, outbound links, goals reached, custom events.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  projectId String
  sessionId String
  slug      String?
  type      String
  ts        DateTime
  data      Json?

  session   AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId, type, ts])
  @@index([sessionId, ts])
  @@map("analytics_events")
}

/// One visitor watching one video during one visit: which seconds were watched, so retention can be drawn second by second.
model VideoView {
  id          String   @id @default(cuid())
  projectId   String
  sessionId   String
  slug        String?
  /// the video's address (our player's src / embed url)
  src         String
  duration    Int      @default(0)
  plays       Int      @default(0)
  /// [[from,to],...] in seconds: the stretches that were actually played (seeks leave gaps)
  ranges      Json     @default("[]")
  maxTime     Int      @default(0)
  watchedSecs Int      @default(0)
  ended       Boolean  @default(false)
  firstPlayAt DateTime?
  /// seconds into the video when the visitor last stopped (paused / left)
  leftAt      Int?
  updatedAt   DateTime @updatedAt

  session     AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, src])
  @@index([projectId, src])
  @@map("analytics_video_views")
}

/// A session recording (rrweb): the metadata here, the events in chunks.
model Recording {
  id         String   @id @default(cuid())
  projectId  String
  sessionId  String   @unique
  startedAt  DateTime
  durationMs Int      @default(0)
  bytes      Int      @default(0)
  events     Int      @default(0)
  pages      Int      @default(1)
  device     String?
  viewportW  Int?
  viewportH  Int?

  session    AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chunks     RecordingChunk[]

  @@index([projectId, startedAt])
  @@map("analytics_recordings")
}

model RecordingChunk {
  id          String   @id @default(cuid())
  recordingId String
  seq         Int
  /// gzip of the JSON array of rrweb events
  data        Bytes
  createdAt   DateTime @default(now())

  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, seq])
  @@map("analytics_recording_chunks")
}

/// An A/B test: the versions (pages of this project) share the traffic, and every visit remembers which one it saw.
model Experiment {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  /// what is being compared: page | headline | image | video | cta | other (a label, the versions are always pages)
  kind        String   @default("page")
  /// running | paused | done
  status      String   @default("running")
  /// the goal that decides the winner: lead | click:<text> | page:<slug> | video:<pct>
  goal        String   @default("lead")
  /// [{id, name, slug, weight}]: slug is the page that version shows
  variants    Json     @default("[]")
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  winner      String?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("experiments")
}

// ─── Published snapshot ──────────────────────────────────
// A frozen copy of a project's pages, written when the user clicks "Publicar".
// The public address (be-vallid.com/s/<slug>) renders ONLY these rows, so the
// editor's unpublished changes never show up for visitors.
model PublishedPage {
  id          String   @id @default(cuid())
  projectId   String
  /// the slug of the page it was copied from (internal links and the phone version point at it)
  pageSlug    String
  name        String
  order       Int      @default(0)
  blocks      Json     @default("[]")
  customCss   String?
  shell       Json?
  publishedAt DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, pageSlug])
  @@map("published_pages")
}

// ─── Scan Job ────────────────────────────────────────────
model ScanJob {
  id          String     @id @default(cuid())
  url         String
  status      ScanStatus @default(QUEUED)
  progress    Int        @default(0)
  currentStep String     @default("Aguardando...")
  resultJson  Json?
  errorMsg    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project     Project?

  @@map("scan_jobs")
}

// ─── Tracking ────────────────────────────────────────────
model ProjectTracking {
  id          String       @id @default(cuid())
  projectId   String
  type        TrackingType
  pixelId     String?
  config      Json         @default("{}")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_trackings")
}

// ─── Lead ────────────────────────────────────────────────
model Lead {
  id          String   @id @default(cuid())
  projectId   String
  email       String?
  phone       String?
  name        String?
  quizAnswers Json     @default("{}")
  utmParams   Json     @default("{}")
  timeline    Json     @default("[]")
  device      String?
  country     String?
  /// the visit (analytics_sessions.id) and the person (visitor id) this lead came from
  sessionId   String?
  visitorId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([email])
  @@index([sessionId])
  @@map("leads")
}

// ─── System Config (SuperAdmin — plataforma SaaS) ────────────────────────────
// Cada chave é uma row com key/value encriptado.
// O superadmin configura via painel — usuários nunca veem as chaves.
model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique  // ex: "openai_api_key", "anthropic_api_key"
  value       String            // valor encriptado com AES-256
  category    ConfigCategory    // AI | STORAGE | EMAIL | PROXY | PAYMENT | GENERAL
  label       String            // label legível: "OpenAI API Key"
  description String?           // descrição do campo
  isSecret    Boolean  @default(true)   // se true, mascarado no frontend
  updatedAt   DateTime @updatedAt
  updatedBy   String?           // clerkUserId do superadmin que atualizou

  @@map("system_configs")
}

// ─── AI Usage Log (custo por operação) ────────────────────────────────────────
model AiUsageLog {
  id            String   @id @default(cuid())
  workspaceId   String
  projectId     String?
  operation     String            // "scan_lp", "quiz_import", "translate", "cloaker"
  model         String            // "gpt-4o", "claude-opus", "gemini-1.5-pro"
  provider      String            // "openai", "anthropic", "google"
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)
  costUsd       Float     @default(0)  // custo real em USD
  creditsUsed   Int       @default(0)  // créditos debitados do usuário
  durationMs    Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([workspaceId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ─── Credit Transaction ─────────────────────────────────────────────────────
model CreditTransaction {
  id            String              @id @default(cuid())
  workspaceId   String
  type          CreditTxType        // GRANT | CONSUME | PURCHASE | REFUND
  amount        Int                 // positivo = adicionou, negativo = consumiu
  balanceAfter  Int
  description   String              // "Scan LP: minha-pagina.com"
  operation     String?             // "scan_lp", "translate", etc.
  stripePaymentId String?
  createdAt     DateTime            @default(now())

  @@index([workspaceId])
  @@map("credit_transactions")
}

// ─── SuperAdmin Session (apenas superadmins) ────────────────────────────────
model SuperAdmin {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String
  createdAt   DateTime @default(now())

  @@map("super_admins")
}

// ─── Enums ───────────────────────────────────────────────
enum Plan {
  FREE
  BASIC
  PRO
  SCALE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectType {
  LP
  QUIZ
  VSL
  CHECKOUT
  FUNNEL
}

enum ProjectStatus {
  PENDING
  SCANNING
  CLONING
  READY
  PUBLISHED
  ERROR
}

enum ScanStatus {
  QUEUED
  SCANNING
  PROCESSING
  DONE
  ERROR
}

enum TrackingType {
  META_PIXEL
  TIKTOK_PIXEL
  GOOGLE_TAG
  GOOGLE_ANALYTICS
  GTM
  CUSTOM
}

// ─── Gamificação & Conquistas ───────────────────────────────────────────────
model UserGamification {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  level           Int      @default(1)       // Nível 1 ao 10 (Iniciante → Black)
  xpPoints        Int      @default(0)       // Pontos de experiência
  streakDays      Int      @default(1)       // Dias seguidos de uso
  lastActiveAt    DateTime @default(now())
  unlockedBadges  Json     @default("[]")    // BadgeID[] desbloqueados

  @@map("user_gamification")
}

model Achievement {
  id          String   @id // "first_clone", "100_leads", "first_publish", etc.
  title       String
  description String
  badgeIcon   String   // Emoji ou ícone
  xpReward    Int      @default(100)
  creditReward Int     @default(25)     // Créditos de IA grátis ao desbloquear
  category    String   // "cloning", "leads", "analytics", "scale"

  @@map("achievements")
}

// ─── Asaas Subscriptions & Charges ──────────────────────────────────────────
model AsaasCustomer {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  asaasCustomerId String   @unique // ID "cus_xxx" no Asaas
  cpfCnpj         String?
  name            String
  email           String
  phone           String?
  createdAt       DateTime @default(now())

  @@map("asaas_customers")
}

model AsaasPayment {
  id              String   @id @default(cuid())
  workspaceId     String
  asaasPaymentId  String   @unique // ID "pay_xxx" no Asaas
  billingType     String   // "PIX" | "BOLETO" | "CREDIT_CARD"
  value           Float
  status          String   // "PENDING" | "RECEIVED" | "CONFIRMED" | "OVERDUE"
  pixQrCode       String?  // Copia e cola PIX
  pixExpiration   DateTime?
  invoiceUrl      String?  // Link de pagamento/fatura
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId])
  @@map("asaas_payments")
}

enum ConfigCategory {
  AI
  STORAGE
  EMAIL
  PROXY
  PAYMENT
  GENERAL
}

enum CreditTxType {
  GRANT
  CONSUME
  PURCHASE
  REFUND
}

// ─── Feedback (messages from users to the admin) ─────────────────────────────
model Feedback {
  id          String   @id @default(cuid())
  workspaceId String
  clerkUserId String?
  email       String?
  /// site_not_cloning | clone_error | bug | idea | praise | other
  kind        String   @default("other")
  /// the site that did not clone right, when that is what this is about
  siteUrl     String?
  projectId   String?
  message     String
  /// what the browser looked like when it was sent
  context     Json?
  /// open | seen | answered | done
  status      String   @default("open")
  reply       String?
  repliedAt   DateTime?
  /// false while the user has not yet seen the admin's answer
  userRead    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@map("feedback")
}

// ─── The administrator's own login (e-mail + password, independent of Clerk) ──
model AdminLogin {
  id           String    @id @default(cuid())
  email        String    @unique
  /// scrypt$salt$hash
  passwordHash String
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_logins")
}

/// A plan the administrator sells or grants. Limits: a number, or null = unlimited. Features: on/off.
model PlanConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  priceCents  Int      @default(0)
  interval    String   @default("month")
  /// false: nobody new can be put on it (accounts already on it keep it)
  active      Boolean  @default(true)
  /// false: not shown on the public pricing page (the unlimited plan is only given by the administrator)
  visible     Boolean  @default(true)
  highlight   Boolean  @default(false)
  ctaLabel    String?
  sortOrder   Int      @default(0)
  /// [{text}]: the lines of the pricing card
  benefits    Json     @default("[]")
  /// {pages, domains, clones, aiCalls, storageMb}: number or null (unlimited)
  limits      Json     @default("{}")
  /// {cloaker, pixels, interactive, prioritySupport}: booleans
  features    Json     @default("{}")
  /// built-in plans (free, unlimited) cannot be deleted
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("plan_configs")
}

/// What the pixels of a published page actually did: one row per (visit, integration, event), moving from fired to sent.
model PixelEvent {
  id          String   @id @default(cuid())
  projectId   String
  /// the analytics visit (analytics_sessions.sid)
  sid         String?
  /// project_trackings.id
  trackingId  String?
  /// META_PIXEL | GOOGLE_ANALYTICS | GOOGLE_TAG | TIKTOK_PIXEL | GTM | CUSTOM
  integration String
  /// the name the vendor received (Lead, generate_lead, ...)
  event       String
  /// which of the project's events caused it (pageview, lead, checkout, purchase, cta, video, custom:<id>)
  key         String
  /// the page (funnel step) it happened on
  slug        String?
  /// fired (called, not confirmed yet) | sent (the browser sent the request) | unconfirmed (called, no request seen) | blocked (the library did not load) | skipped (consent / do-not-track)
  state       String
  value       Float?
  currency    String?
  /// a test run from the Pixels tab: never counted in the metrics
  test        Boolean  @default(false)
  /// one row per (visit, integration, event, key, page): the guard against duplicates
  dedupe      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, dedupe])
  @@index([projectId, createdAt])
  @@index([projectId, integration, event])
  @@map("pixel_events")
}
