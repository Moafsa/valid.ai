{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": "/web",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "next/navigation": [
        "/ui/stubs/next-navigation.ts"
      ],
      "next/link": [
        "/ui/stubs/next-link.tsx"
      ],
      "*": [
        "/ui/node_modules/@types/*",
        "/ui/node_modules/*"
      ],
      "@funnelai/db": [
        "/ui/stubs/db.d.ts"
      ]
    },
    "typeRoots": [
      "/ui/node_modules/@types"
    ],
    "types": [
      "react",
      "react-dom"
    ]
  },
  "files": [
    "/web/src/components/editor/visual-editor.tsx",
    "/web/src/components/editor/ai-assistant-panel.tsx",
    "/web/src/components/editor/element-inspector.tsx",
    "/web/src/components/editor/editor-publish-dialog.tsx",
    "/web/src/lib/visual-editor/ai-engine.ts",
    "/web/src/lib/visual-editor/ai-types.ts",
    "/web/src/lib/visual-editor/starter-blocks.ts",
    "/web/src/components/dashboard/flow-dashboard.tsx",
    "/web/src/components/dashboard/flow-map.tsx",
    "/web/src/components/dashboard/clone-review-card.tsx",
    "/web/src/lib/flow-graph.ts",
    "/web/src/lib/clone-flow.ts"
  ]
}