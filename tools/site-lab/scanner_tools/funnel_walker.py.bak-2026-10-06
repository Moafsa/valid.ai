DUMMY_NAME = "Marilu Tavares"
DUMMY_EMAIL = "marilu.tavares@example.com"
DUMMY_PHONE = "11987654321"
OK_JSON = '{"success":true,"ok":true,"status":"ok","valid":true,"data":{}}'


def _host(u: str) -> str:
    return (urlparse(u).hostname or "").lower().removeprefix("www.")


def clean_exit_url(url: str) -> str:
    """Where a funnel ends often carries what the walker typed ("?name=Maria
    Silva&email=…"). That must not reach real visitors: swap it for
    placeholders the clone fills with what THEY typed."""
    try:
        parts = urlsplit(url)
        out = []
        for k, v in parse_qsl(parts.query, keep_blank_values=True):
            # who-this-visitor-is parameters belong to the walker's visit, not to the clone
            if k.lower() in ("fbp", "fbc", "fbclid", "gclid", "_ga", "_gl", "msclkid", "ttclid", "src", "sck", "xcod") or k.lower().startswith("utm_"):
                continue
            v = re.sub(re.escape(DUMMY_NAME), "{{nome}}", v, flags=re.I)
            v = re.sub(re.escape(DUMMY_EMAIL), "{{email}}", v, flags=re.I)
            if re.sub(r"\D", "", v).endswith("987654321") and len(re.sub(r"\D", "", v)) <= 13:
                v = "{{telefone}}"
            out.append((k, v))
        path = parts.path
        path = re.sub(r"55?11987654321", "{{telefone}}", path)
        return urlunsplit((parts.scheme, parts.netloc, path, urlencode(out, safe="{}@:"), parts.fragment))
    except Exception:
        return url


_TEXT_RUN = re.compile(r">([^<>]+)<")


def personalize(html: str) -> str:
    """Screens after a "what's your name?" question greet the person by what the walker typed ("Ótimo,
    Marilu!"). The clone must greet whoever is visiting: those words become <span data-vai-var>, filled by
    the runtime from what the visitor typed (and left as a neutral word when they did not)."""
    first = DUMMY_NAME.split()[0]

    def fix(m):
        t = m.group(1)
        if DUMMY_NAME.lower() not in t.lower() and first.lower() not in t.lower() and DUMMY_EMAIL.lower() not in t.lower():
            return m.group(0)
        t = re.sub(re.escape(DUMMY_EMAIL), '<span data-vai-var="email">' + DUMMY_EMAIL + "</span>", t, flags=re.I)
        t = re.sub(re.escape(DUMMY_NAME), '<span data-vai-var="nome">' + DUMMY_NAME + "</span>", t, flags=re.I)
        # the first name alone, where it is not already inside one of the spans above
        t = re.sub(r"(?<![\w>])" + re.escape(first) + r"(?![\w<])", '<span data-vai-var="nome1">' + first + "</span>", t, flags=re.I)
        return ">" + t + "<"

    return _TEXT_RUN.sub(fix, html)


def sig_replaced(a: dict, b: dict) -> bool:
    """Was the SCREEN swapped for another (as opposed to something new
    appearing on it)? Used to tell "the app moved on by itself" from "a
    button showed up after 12s"."""
    if a.get("path") != b.get("path"):
        return True
    if a.get("ids") and b.get("ids"):
        # the builder's own step id is the truth: a progress bar that animates
        # (or a heading that types itself) inside one step is not a new step
        return a["ids"] != b["ids"]
    if a.get("heads") != b.get("heads") and (a.get("heads") or b.get("heads")) and not (not a.get("heads") and b.get("heads")):
        return True
    if a.get("prog") != b.get("prog"):
        return True
    return False


def sig_changed(a: dict, b: dict) -> bool:
    """Did the visitor-visible screen change between two signatures?"""
    if sig_replaced(a, b):
        return True
    if a.get("heads") != b.get("heads"):
        return True
    if a.get("media") != b.get("media"):
        return True
    ba, bb = set(a.get("btns") or []), set(b.get("btns") or [])
    if ba or bb:
        jac = len(ba & bb) / max(len(ba | bb), 1)
        if jac < 0.6:
            return True
    return False


def is_overlay(before: dict, now: dict) -> bool:
    """A big fixed layer appeared AND the screen under it is still the old one.
    A funnel app that merely swaps its screens may also have fixed layers, and
    consecutive screens often share a "Continuar": so the builder's own step id
    (when there is one) settles it, then the headings; buttons count only when
    the old screen had no heading and the layer ADDED some."""
    if not now.get("overlay") or before.get("overlay"):
        return False
    if before.get("ids") and now.get("ids") and not set(before["ids"]) <= set(now["ids"]):
        return False   # the old screen's own container is gone: a swap, not a layer on top
    old_heads, new_heads = set(before.get("heads") or []), set(now.get("heads") or [])
    if old_heads:
        return bool(old_heads & new_heads)
    old_btns, new_btns = set(before.get("btns") or []), set(now.get("btns") or [])
    return bool(old_btns) and len(new_btns) > len(old_btns) and len(old_btns & new_btns) / len(old_btns) >= 0.7


# Ids every screen of an app shares (the framework's root, a cookie banner): they
# say nothing about WHICH screen this is, and treating them as the screen's id
# makes every step of such an app look like the same one.
GENERIC_ID = re.compile(
    r"^(__next|__nuxt|__gatsby|__remix.*|root|app|page|main|content|wrapper|layout|container|portal.*|modal-root|"
    r"onetrust.*|ot-.*|cookie.*|cc-.*|consent.*|usercentrics.*|headlessui.*|radix-.*|react-.*|chakra.*|intercom.*|hotjar.*|"
    r"__.*)$", re.I)


def node_key(sig: dict) -> str:
    """Identity of a screen: what stays the same however many times and by
    whichever route you arrive. Builders give every step its own element id
    (stable across visits), which is the best handle there is. Without it,
    the headings / video; the progress bar only as a last resort, because it
    animates while a screen is being watched."""
    # the BUTTONS tell screens apart too (a quiz whose every screen is titled "Pergunta" is told apart by its
    # answers; a chat that grows inside the same containers by what it offers next); labels that tick (a clock,
    # a percentage) are left out so they do not make a new screen
    btns = sorted({b[:30] for b in (sig.get("btns") or []) if not re.search(r"\d\s*[:%]|\(\d+\s*s\)|\d+\s*(seg|min|sec)", b)})[:8]
    ids = [i for i in (sig.get("ids") or []) if not GENERIC_ID.match(i)]
    if ids:
        return json.dumps([sig.get("path"), ids, btns], ensure_ascii=False)
    if sig.get("heads") or sig.get("media"):
        return json.dumps([sig.get("path"), sig.get("heads"), sig.get("media"), btns], ensure_ascii=False)
    return json.dumps([sig.get("path"), [], [], sig.get("prog"), btns], ensure_ascii=False)


def slug_for(index: int, prefix: str = "") -> str:
    if prefix:
        return prefix if index == 0 else f"{prefix}-etapa-{index + 1}"
    return "home" if index == 0 else f"etapa-{index + 1}"


def _dummy_for(field_: dict) -> Optional[str]:
    t = (field_.get("type") or "text").lower()
    hint = " ".join([field_.get("name") or "", field_.get("placeholder") or "", field_.get("label") or "", field_.get("autocomplete") or ""]).lower()
    if t in ("checkbox", "radio", "hidden", "file", "submit", "button", "range", "color", "password"):
        return None
    if t == "email" or "mail" in hint:
        return DUMMY_EMAIL
    if t == "tel" or re.search(r"whats|celular|telefone|fone|phone|\bddd\b", hint):
        return DUMMY_PHONE
    if "cpf" in hint:
        return "52998224725"
    if "cnpj" in hint:
        return "11222333000181"
    if "cep" in hint:
        return "01310100"
    if "crm" in hint or "registro" in hint:
        return "123456"
    if t == "number" or re.search(r"idade|age|peso|altura|quant", hint):
        return "35"
    if t == "date":
        return "1990-05-20"
    return DUMMY_NAME


